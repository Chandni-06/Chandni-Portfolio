<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="100%" height="100%">
  <defs>
    <linearGradient id="bg-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="50%" stop-color="#1e293b" />
      <stop offset="100%" stop-color="#0b1120" />
    </linearGradient>
    <linearGradient id="circle-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2563eb" />
      <stop offset="50%" stop-color="#0ea5e9" />
      <stop offset="100%" stop-color="#38bdf8" />
    </linearGradient>
    <linearGradient id="card-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="rgba(30, 41, 59, 0.9)" />
      <stop offset="100%" stop-color="rgba(15, 23, 42, 0.9)" />
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="15" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Background Canvas -->
  <rect width="800" height="800" fill="url(#bg-grad)" rx="40" />

  <!-- Animated Grid Overlay -->
  <g opacity="0.1" stroke="#38bdf8" stroke-width="1">
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" />
    </pattern>
    <rect width="800" height="800" fill="url(#grid)" />
  </g>

  <!-- Glowing Backdrop Circles -->
  <circle cx="400" cy="380" r="260" fill="none" stroke="url(#circle-grad)" stroke-width="4" filter="url(#glow)" opacity="0.6" />
  <circle cx="400" cy="380" r="230" fill="none" stroke="#0ea5e9" stroke-width="1.5" stroke-dasharray="10 8" opacity="0.8" />

  <!-- Avatar Base Silhouette & Illustration -->
  <g transform="translate(400, 380)">
    <!-- Aura Glow behind avatar -->
    <circle cx="0" cy="0" r="200" fill="#2563eb" opacity="0.15" filter="url(#glow)"/>
    
    <!-- Profile Circle Frame -->
    <circle cx="0" cy="0" r="190" fill="#1e293b" stroke="url(#circle-grad)" stroke-width="6" />

    <!-- Avatar Stylized Character -->
    <g transform="translate(0, 20)">
      <!-- Shoulders/Blazer -->
      <path d="M -130 160 C -120 80 -60 60 0 60 C 60 60 120 80 130 160 Z" fill="#2563eb" />
      <!-- Shirt/V-neck -->
      <path d="M -35 80 L 0 130 L 35 80 Z" fill="#ffffff" opacity="0.9" />
      <path d="M -15 80 L 0 140 L 15 80 Z" fill="#0ea5e9" />

      <!-- Neck -->
      <rect x="-22" y="10" width="44" height="60" rx="8" fill="#e2e8f0" />

      <!-- Head & Face -->
      <path d="M -50 -30 C -50 -85 50 -85 50 -30 C 50 30 -50 30 -50 -30 Z" fill="#f8fafc" />
      
      <!-- Hair -->
      <path d="M -60 -40 C -60 -110 60 -110 60 -40 C 60 -20 55 20 45 60 C 35 40 40 -60 0 -60 C -40 -60 -35 40 -45 60 C -55 20 -60 -20 -60 -40 Z" fill="#0f172a" />

      <!-- Glasses (Data Professional Look) -->
      <rect x="-42" y="-35" width="34" height="24" rx="4" fill="none" stroke="#38bdf8" stroke-width="3" />
      <rect x="8" y="-35" width="34" height="24" rx="4" fill="none" stroke="#38bdf8" stroke-width="3" />
      <line x1="-8" y1="-23" x2="8" y2="-23" stroke="#38bdf8" stroke-width="3" />

      <!-- Smile -->
      <path d="M -18 5 C -10 18 10 18 18 5" fill="none" stroke="#0f172a" stroke-width="3" stroke-linecap="round" />
    </g>
  </g>
</svg>
