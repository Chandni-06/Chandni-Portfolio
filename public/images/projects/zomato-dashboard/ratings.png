<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#0F172A" /><stop offset="100%" stop-color="#1E293B" /></linearGradient>
    <linearGradient id="cardBg" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#1E293B" /><stop offset="100%" stop-color="#0F172A" /></linearGradient>
  </defs>
  <rect width="1200" height="675" fill="url(#bg)" />
  <rect x="40" y="30" width="1120" height="70" rx="16" fill="url(#cardBg)" stroke="#334155" />
  <text x="70" y="72" font-family="Arial" font-weight="900" font-size="22" fill="#F59E0B">CUSTOMER RATING DISTRIBUTION &amp; SENTIMENT ANALYSIS</text>

  <g transform="translate(40, 130)">
    <rect width="1120" height="500" rx="16" fill="url(#cardBg)" stroke="#334155" />
    <text x="40" y="50" font-family="Arial" font-weight="800" font-size="16" fill="#FFF">RATING BREAKDOWN (1.0 TO 5.0 STARS)</text>
    
    <!-- Rating Histogram -->
    <rect x="60" y="320" width="150" height="80" rx="8" fill="#EF4444" />
    <text x="135" y="420" font-family="Arial" font-weight="700" font-size="14" fill="#FFF" text-anchor="middle">2.0 - 2.9 (Poor)</text>
    <text x="135" y="305" font-family="Arial" font-weight="800" font-size="14" fill="#EF4444" text-anchor="middle">1,001</text>

    <rect x="250" y="240" width="150" height="160" rx="8" fill="#F59E0B" />
    <text x="325" y="420" font-family="Arial" font-weight="700" font-size="14" fill="#FFF" text-anchor="middle">3.0 - 3.4 (Average)</text>
    <text x="325" y="225" font-family="Arial" font-weight="800" font-size="14" fill="#F59E0B" text-anchor="middle">2,120</text>

    <rect x="440" y="140" width="150" height="260" rx="8" fill="#10B981" />
    <text x="515" y="420" font-family="Arial" font-weight="700" font-size="14" fill="#FFF" text-anchor="middle">3.5 - 3.9 (Good)</text>
    <text x="515" y="125" font-family="Arial" font-weight="800" font-size="14" fill="#10B981" text-anchor="middle">3,680</text>

    <rect x="630" y="180" width="150" height="220" rx="8" fill="#38BDF8" />
    <text x="705" y="420" font-family="Arial" font-weight="700" font-size="14" fill="#FFF" text-anchor="middle">4.0 - 4.4 (Very Good)</text>
    <text x="705" y="165" font-family="Arial" font-weight="800" font-size="14" fill="#38BDF8" text-anchor="middle">2,205</text>

    <rect x="820" y="350" width="150" height="50" rx="8" fill="#8B5CF6" />
    <text x="895" y="420" font-family="Arial" font-weight="700" font-size="14" fill="#FFF" text-anchor="middle">4.5 - 5.0 (Excellent)</text>
    <text x="895" y="335" font-family="Arial" font-weight="800" font-size="14" fill="#8B5CF6" text-anchor="middle">545</text>
  </g>
</svg>
