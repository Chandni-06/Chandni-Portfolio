<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#0F172A" /><stop offset="100%" stop-color="#1E293B" /></linearGradient>
    <linearGradient id="cardBg" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#1E293B" /><stop offset="100%" stop-color="#0F172A" /></linearGradient>
  </defs>
  <rect width="1200" height="675" fill="url(#bg)" />
  <!-- Header -->
  <rect x="30" y="20" width="1140" height="60" rx="12" fill="url(#cardBg)" stroke="#334155" />
  <rect x="45" y="32" width="36" height="36" rx="8" fill="#E23744" />
  <text x="63" y="56" font-family="Arial" font-weight="900" font-size="20" fill="#FFF" text-anchor="middle">Z</text>
  <text x="95" y="55" font-family="Arial" font-weight="800" font-size="18" fill="#FFF">POWER BI FULL INTERACTIVE DASHBOARD VIEW</text>
  
  <!-- Left Sidebar Filter Pane -->
  <rect x="30" y="95" width="240" height="555" rx="12" fill="url(#cardBg)" stroke="#334155" />
  <text x="50" y="130" font-family="Arial" font-weight="800" font-size="14" fill="#E23744">SLICERS &amp; FILTERS</text>
  <rect x="50" y="150" width="200" height="35" rx="8" fill="#334155" />
  <text x="65" y="172" font-family="Arial" font-size="12" fill="#FFF">City: All Cities (5)</text>
  <rect x="50" y="200" width="200" height="35" rx="8" fill="#334155" />
  <text x="65" y="222" font-family="Arial" font-size="12" fill="#FFF">Has Online Delivery: Yes</text>
  <rect x="50" y="250" width="200" height="35" rx="8" fill="#334155" />
  <text x="65" y="272" font-family="Arial" font-size="12" fill="#FFF">Has Table Booking: All</text>
  <rect x="50" y="300" width="200" height="35" rx="8" fill="#334155" />
  <text x="65" y="322" font-family="Arial" font-size="12" fill="#FFF">Price Range: 1 - 4</text>
  
  <!-- Top 4 KPIs -->
  <g transform="translate(290, 95)">
    <rect width="205" height="90" rx="10" fill="url(#cardBg)" stroke="#334155" />
    <text x="15" y="30" font-family="Arial" font-size="11" fill="#94A3B8">RESTAURANT COUNT</text>
    <text x="15" y="65" font-family="Arial" font-weight="900" font-size="28" fill="#FFF">9,551</text>
    
    <rect x="220" y="0" width="205" height="90" rx="10" fill="url(#cardBg)" stroke="#334155" />
    <text x="235" y="30" font-family="Arial" font-size="11" fill="#94A3B8">AVG RATING</text>
    <text x="235" y="65" font-family="Arial" font-weight="900" font-size="28" fill="#F59E0B">4.21 ★</text>

    <rect x="440" y="0" width="205" height="90" rx="10" fill="url(#cardBg)" stroke="#334155" />
    <text x="455" y="30" font-family="Arial" font-size="11" fill="#94A3B8">AVG COST (FOR TWO)</text>
    <text x="455" y="65" font-family="Arial" font-weight="900" font-size="28" fill="#10B981">₹580</text>

    <rect x="660" y="0" width="220" height="90" rx="10" fill="url(#cardBg)" stroke="#334155" />
    <text x="675" y="30" font-family="Arial" font-size="11" fill="#94A3B8">ONLINE DELIVERY %</text>
    <text x="675" y="65" font-family="Arial" font-weight="900" font-size="28" fill="#38BDF8">78.4%</text>
  </g>

  <!-- Big Middle Charts Area -->
  <g transform="translate(290, 200)">
    <rect width="510" height="450" rx="12" fill="url(#cardBg)" stroke="#334155" />
    <text x="20" y="35" font-family="Arial" font-weight="800" font-size="15" fill="#FFF">RATING vs COST FOR TWO SCATTER MATRIX</text>
    <!-- Scatter Plot Mockup -->
    <path d="M50,380 L470,380 M50,80 L50,380" stroke="#475569" stroke-width="2" />
    <circle cx="120" cy="300" r="8" fill="#E23744" opacity="0.8" />
    <circle cx="180" cy="250" r="12" fill="#E23744" opacity="0.8" />
    <circle cx="220" cy="200" r="16" fill="#F59E0B" opacity="0.8" />
    <circle cx="290" cy="150" r="10" fill="#10B981" opacity="0.8" />
    <circle cx="360" cy="120" r="22" fill="#38BDF8" opacity="0.8" />
    <circle cx="420" cy="90" r="14" fill="#8B5CF6" opacity="0.8" />
  </g>

  <g transform="translate(815, 200)">
    <rect width="355" height="450" rx="12" fill="url(#cardBg)" stroke="#334155" />
    <text x="20" y="35" font-family="Arial" font-weight="800" font-size="15" fill="#FFF">PRICE RANGE DISTRIBUTION</text>
    <rect x="30" y="80" width="220" height="30" rx="6" fill="#10B981" />
    <text x="260" y="100" font-family="Arial" font-weight="700" font-size="12" fill="#FFF">Price 1 (4,444)</text>
    <rect x="30" y="130" width="180" height="30" rx="6" fill="#38BDF8" />
    <text x="220" y="150" font-family="Arial" font-weight="700" font-size="12" fill="#FFF">Price 2 (3,113)</text>
    <rect x="30" y="180" width="110" height="30" rx="6" fill="#F59E0B" />
    <text x="150" y="200" font-family="Arial" font-weight="700" font-size="12" fill="#FFF">Price 3 (1,408)</text>
    <rect x="30" y="230" width="60" height="30" rx="6" fill="#E23744" />
    <text x="100" y="250" font-family="Arial" font-weight="700" font-size="12" fill="#FFF">Price 4 (586)</text>
  </g>
</svg>
