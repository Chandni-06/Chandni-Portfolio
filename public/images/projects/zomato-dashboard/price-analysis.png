<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#0F172A" /><stop offset="100%" stop-color="#1E293B" /></linearGradient>
    <linearGradient id="cardBg" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#1E293B" /><stop offset="100%" stop-color="#0F172A" /></linearGradient>
  </defs>
  <rect width="1200" height="675" fill="url(#bg)" />
  <rect x="40" y="30" width="1120" height="70" rx="16" fill="url(#cardBg)" stroke="#334155" />
  <text x="70" y="72" font-family="Arial" font-weight="900" font-size="22" fill="#10B981">PRICE RANGE SEGMENTATION &amp; COST BREAKDOWN</text>

  <g transform="translate(40, 130)">
    <rect width="1120" height="500" rx="16" fill="url(#cardBg)" stroke="#334155" />
    <text x="40" y="50" font-family="Arial" font-weight="800" font-size="16" fill="#FFF">PRICE RANGE BUCKETS (1 = BUDGET, 4 = LUXURY FINE DINING)</text>
    
    <rect x="60" y="100" width="1000" height="70" rx="12" fill="#10B981" />
    <text x="90" y="142" font-family="Arial" font-weight="900" font-size="20" fill="#FFF">Range 1 (Budget Dining: &lt; ₹400) — 4,444 Restaurants (46.5%)</text>

    <rect x="60" y="200" width="700" height="70" rx="12" fill="#38BDF8" />
    <text x="90" y="242" font-family="Arial" font-weight="900" font-size="20" fill="#FFF">Range 2 (Mid-Range: ₹400 - ₹800) — 3,113 Restaurants (32.6%)</text>

    <rect x="60" y="300" width="320" height="70" rx="12" fill="#F59E0B" />
    <text x="90" y="342" font-family="Arial" font-weight="900" font-size="20" fill="#FFF">Range 3 (Premium: ₹800 - ₹1500) — 1,408 Rest. (14.7%)</text>

    <rect x="60" y="400" width="150" height="70" rx="12" fill="#E23744" />
    <text x="90" y="442" font-family="Arial" font-weight="900" font-size="20" fill="#FFF">Range 4 (&gt; ₹1500) — 586 Rest. (6.2%)</text>
  </g>
</svg>
