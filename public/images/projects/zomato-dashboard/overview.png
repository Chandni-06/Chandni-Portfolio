<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#0F172A" /><stop offset="100%" stop-color="#1E293B" /></linearGradient>
    <linearGradient id="cardBg" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#1E293B" /><stop offset="100%" stop-color="#0F172A" /></linearGradient>
  </defs>
  <rect width="1200" height="675" fill="url(#bg)" />
  <rect x="40" y="30" width="1120" height="70" rx="16" fill="url(#cardBg)" stroke="#334155" />
  <text x="70" y="72" font-family="Arial" font-weight="900" font-size="22" fill="#E23744">ZOMATO EXECUTIVE OVERVIEW DASHBOARD</text>
  
  <g transform="translate(40, 130)">
    <rect width="350" height="500" rx="16" fill="url(#cardBg)" stroke="#334155" />
    <text x="25" y="45" font-family="Arial" font-weight="800" font-size="16" fill="#FFF">EXECUTIVE KPI SUMMARY</text>
    <text x="25" y="100" font-family="Arial" font-size="13" fill="#94A3B8">Total Restaurants Analyzed:</text>
    <text x="25" y="130" font-family="Arial" font-weight="900" font-size="32" fill="#E23744">9,551</text>
    <text x="25" y="180" font-family="Arial" font-size="13" fill="#94A3B8">Global Cities Covered:</text>
    <text x="25" y="210" font-family="Arial" font-weight="900" font-size="32" fill="#F59E0B">22 Cities</text>
    <text x="25" y="260" font-family="Arial" font-size="13" fill="#94A3B8">Average Rating Score:</text>
    <text x="25" y="290" font-family="Arial" font-weight="900" font-size="32" fill="#10B981">4.2 / 5.0</text>
  </g>

  <g transform="translate(410, 130)">
    <rect width="750" height="500" rx="16" fill="url(#cardBg)" stroke="#334155" />
    <text x="30" y="45" font-family="Arial" font-weight="800" font-size="16" fill="#FFF">CITY-WISE PERFORMANCE LEADERBOARD</text>
    <path d="M50,90 L700,90" stroke="#334155" stroke-width="2" />
    <text x="50" y="125" font-family="Arial" font-weight="700" font-size="14" fill="#38BDF8">1. New Delhi — 5,473 Restaurants (Avg Rating 4.1, Avg Cost ₹520)</text>
    <text x="50" y="175" font-family="Arial" font-weight="700" font-size="14" fill="#38BDF8">2. Gurgaon — 1,118 Restaurants (Avg Rating 4.3, Avg Cost ₹710)</text>
    <text x="50" y="225" font-family="Arial" font-weight="700" font-size="14" fill="#38BDF8">3. Noida — 780 Restaurants (Avg Rating 4.0, Avg Cost ₹480)</text>
    <text x="50" y="275" font-family="Arial" font-weight="700" font-size="14" fill="#38BDF8">4. Bengaluru — 591 Restaurants (Avg Rating 4.4, Avg Cost ₹650)</text>
    <text x="50" y="325" font-family="Arial" font-weight="700" font-size="14" fill="#38BDF8">5. Mumbai — 482 Restaurants (Avg Rating 4.3, Avg Cost ₹750)</text>
  </g>
</svg>
