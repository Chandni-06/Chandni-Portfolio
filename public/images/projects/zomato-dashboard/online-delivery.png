<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#0F172A" /><stop offset="100%" stop-color="#1E293B" /></linearGradient>
    <linearGradient id="cardBg" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#1E293B" /><stop offset="100%" stop-color="#0F172A" /></linearGradient>
  </defs>
  <rect width="1200" height="675" fill="url(#bg)" />
  <rect x="40" y="30" width="1120" height="70" rx="16" fill="url(#cardBg)" stroke="#334155" />
  <text x="70" y="72" font-family="Arial" font-weight="900" font-size="22" fill="#38BDF8">ONLINE DELIVERY &amp; TABLE BOOKING DYNAMICS</text>

  <g transform="translate(40, 130)">
    <rect width="540" height="500" rx="16" fill="url(#cardBg)" stroke="#334155" />
    <text x="40" y="50" font-family="Arial" font-weight="800" font-size="16" fill="#FFF">ONLINE DELIVERY AVAILABILITY</text>
    <circle cx="270" cy="270" r="130" fill="none" stroke="#334155" stroke-width="40" />
    <circle cx="270" cy="270" r="130" fill="none" stroke="#38BDF8" stroke-width="40" stroke-dasharray="640 816" />
    <text x="270" y="260" font-family="Arial" font-weight="900" font-size="36" fill="#FFF" text-anchor="middle">78.4%</text>
    <text x="270" y="295" font-family="Arial" font-size="14" fill="#38BDF8" text-anchor="middle">Offers Online Delivery</text>
  </g>

  <g transform="translate(620, 130)">
    <rect width="540" height="500" rx="16" fill="url(#cardBg)" stroke="#334155" />
    <text x="40" y="50" font-family="Arial" font-weight="800" font-size="16" fill="#FFF">TABLE BOOKING AVAILABILITY</text>
    <circle cx="270" cy="270" r="130" fill="none" stroke="#334155" stroke-width="40" />
    <circle cx="270" cy="270" r="130" fill="none" stroke="#10B981" stroke-width="40" stroke-dasharray="180 816" />
    <text x="270" y="260" font-family="Arial" font-weight="900" font-size="36" fill="#FFF" text-anchor="middle">12.1%</text>
    <text x="270" y="295" font-family="Arial" font-size="14" fill="#10B981" text-anchor="middle">Has Table Booking</text>
  </g>
</svg>
