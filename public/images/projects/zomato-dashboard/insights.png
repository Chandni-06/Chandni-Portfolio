<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#0F172A" /><stop offset="100%" stop-color="#1E293B" /></linearGradient>
    <linearGradient id="cardBg" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#1E293B" /><stop offset="100%" stop-color="#0F172A" /></linearGradient>
  </defs>
  <rect width="1200" height="675" fill="url(#bg)" />
  <rect x="40" y="30" width="1120" height="70" rx="16" fill="url(#cardBg)" stroke="#334155" />
  <text x="70" y="72" font-family="Arial" font-weight="900" font-size="22" fill="#10B981">EXECUTIVE BUSINESS INSIGHTS &amp; STRATEGIC RECOMMENDATIONS</text>

  <g transform="translate(40, 130)">
    <rect width="1120" height="500" rx="16" fill="url(#cardBg)" stroke="#334155" />
    
    <g transform="translate(40, 40)">
      <circle cx="20" cy="20" r="16" fill="#10B981" />
      <text x="20" y="26" font-family="Arial" font-weight="900" font-size="16" fill="#FFF" text-anchor="middle">1</text>
      <text x="55" y="25" font-family="Arial" font-weight="800" font-size="16" fill="#FFF">Delivery Drive Impact:</text>
      <text x="55" y="48" font-family="Arial" font-size="14" fill="#94A3B8">Restaurants offering online delivery record 0.4★ higher average customer rating compared to non-delivery outlets.</text>

      <circle cx="20" cy="110" r="16" fill="#38BDF8" />
      <text x="20" y="116" font-family="Arial" font-weight="900" font-size="16" fill="#FFF" text-anchor="middle">2</text>
      <text x="55" y="115" font-family="Arial" font-weight="800" font-size="16" fill="#FFF">Cuisine Opportunity Gap:</text>
      <text x="55" y="138" font-family="Arial" font-size="14" fill="#94A3B8">North Indian &amp; Chinese dominate 56% of overall supply, while Continental &amp; Healthy options present high-rating unmet demand.</text>

      <circle cx="20" cy="200" r="16" fill="#F59E0B" />
      <text x="20" y="206" font-family="Arial" font-weight="900" font-size="16" fill="#FFF" text-anchor="middle">3</text>
      <text x="55" y="205" font-family="Arial" font-weight="800" font-size="16" fill="#FFF">Price Sensitivity Sweetspot:</text>
      <text x="55" y="228" font-family="Arial" font-size="14" fill="#94A3B8">Price Range 2 (₹400 - ₹800) generates highest repeat order frequency and optimal margin balance.</text>

      <circle cx="20" cy="290" r="16" fill="#E23744" />
      <text x="20" y="296" font-family="Arial" font-weight="900" font-size="16" fill="#FFF" text-anchor="middle">4</text>
      <text x="55" y="295" font-family="Arial" font-weight="800" font-size="16" fill="#FFF">Geographic Density Concentration:</text>
      <text x="55" y="318" font-family="Arial" font-size="14" fill="#94A3B8">New Delhi accounts for 57% of total restaurant listings, whereas Bengaluru exhibits highest average order satisfaction (4.41★).</text>
    </g>
  </g>
</svg>
