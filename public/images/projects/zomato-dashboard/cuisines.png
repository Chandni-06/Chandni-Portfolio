<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#0F172A" /><stop offset="100%" stop-color="#1E293B" /></linearGradient>
    <linearGradient id="cardBg" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#1E293B" /><stop offset="100%" stop-color="#0F172A" /></linearGradient>
  </defs>
  <rect width="1200" height="675" fill="url(#bg)" />
  <rect x="40" y="30" width="1120" height="70" rx="16" fill="url(#cardBg)" stroke="#334155" />
  <text x="70" y="72" font-family="Arial" font-weight="900" font-size="22" fill="#10B981">CUISINE PREFERENCE &amp; CATEGORY DIVERSITY MATRIX</text>

  <g transform="translate(40, 130)">
    <rect width="1120" height="500" rx="16" fill="url(#cardBg)" stroke="#334155" />
    <text x="40" y="50" font-family="Arial" font-weight="800" font-size="16" fill="#FFF">TOP 10 CUISINES BY RESTAURANT COUNT</text>

    <!-- Cuisine Treemap Grid Mockup -->
    <rect x="40" y="80" width="400" height="200" fill="#E23744" rx="10" />
    <text x="60" y="120" font-family="Arial" font-weight="900" font-size="20" fill="#FFF">North Indian</text>
    <text x="60" y="150" font-family="Arial" font-weight="700" font-size="16" fill="#FFF">3,960 Restaurants</text>

    <rect x="450" y="80" width="350" height="200" fill="#F59E0B" rx="10" />
    <text x="470" y="120" font-family="Arial" font-weight="900" font-size="20" fill="#FFF">Chinese</text>
    <text x="470" y="150" font-family="Arial" font-weight="700" font-size="16" fill="#FFF">2,735 Restaurants</text>

    <rect x="810" y="80" width="270" height="200" fill="#10B981" rx="10" />
    <text x="830" y="120" font-family="Arial" font-weight="900" font-size="20" fill="#FFF">Fast Food</text>
    <text x="830" y="150" font-family="Arial" font-weight="700" font-size="16" fill="#FFF">1,986 Restaurants</text>

    <rect x="40" y="295" width="300" height="175" fill="#38BDF8" rx="10" />
    <text x="60" y="335" font-family="Arial" font-weight="900" font-size="18" fill="#FFF">Mughlai</text>
    <text x="60" y="365" font-family="Arial" font-weight="700" font-size="14" fill="#FFF">1,570 Restaurants</text>

    <rect x="350" y="295" width="300" height="175" fill="#8B5CF6" rx="10" />
    <text x="370" y="335" font-family="Arial" font-weight="900" font-size="18" fill="#FFF">Italian / Pizza</text>
    <text x="370" y="365" font-family="Arial" font-weight="700" font-size="14" fill="#FFF">1,244 Restaurants</text>

    <rect x="660" y="295" width="420" height="175" fill="#EC4899" rx="10" />
    <text x="680" y="335" font-family="Arial" font-weight="900" font-size="18" fill="#FFF">Continental, Bakery &amp; Cafe</text>
    <text x="680" y="365" font-family="Arial" font-weight="700" font-size="14" fill="#FFF">1,890 Combined Listings</text>
  </g>
</svg>
