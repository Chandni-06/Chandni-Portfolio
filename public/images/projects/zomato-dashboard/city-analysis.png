<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#0F172A" /><stop offset="100%" stop-color="#1E293B" /></linearGradient>
    <linearGradient id="cardBg" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#1E293B" /><stop offset="100%" stop-color="#0F172A" /></linearGradient>
  </defs>
  <rect width="1200" height="675" fill="url(#bg)" />
  <rect x="40" y="30" width="1120" height="70" rx="16" fill="url(#cardBg)" stroke="#334155" />
  <text x="70" y="72" font-family="Arial" font-weight="900" font-size="22" fill="#38BDF8">GEOGRAPHIC &amp; CITY-WISE RESTAURANT DISTRIBUTION</text>

  <g transform="translate(40, 130)">
    <rect width="1120" height="500" rx="16" fill="url(#cardBg)" stroke="#334155" />
    <text x="40" y="50" font-family="Arial" font-weight="800" font-size="16" fill="#FFF">CITY COMPARISON MATRIX</text>
    <path d="M50,90 L1070,90" stroke="#334155" stroke-width="2" />
    <text x="60" y="120" font-family="Arial" font-weight="700" font-size="14" fill="#94A3B8">City</text>
    <text x="250" y="120" font-family="Arial" font-weight="700" font-size="14" fill="#94A3B8">Restaurants</text>
    <text x="450" y="120" font-family="Arial" font-weight="700" font-size="14" fill="#94A3B8">Avg Rating</text>
    <text x="650" y="120" font-family="Arial" font-weight="700" font-size="14" fill="#94A3B8">Avg Cost (2 Pax)</text>
    <text x="880" y="120" font-family="Arial" font-weight="700" font-size="14" fill="#94A3B8">Online Delivery %</text>

    <path d="M50,140 L1070,140" stroke="#334155" />
    <text x="60" y="170" font-family="Arial" font-weight="700" font-size="14" fill="#FFF">New Delhi</text>
    <text x="250" y="170" font-family="Arial" font-weight="800" font-size="14" fill="#E23744">5,473</text>
    <text x="450" y="170" font-family="Arial" font-weight="800" font-size="14" fill="#F59E0B">4.12 ★</text>
    <text x="650" y="170" font-family="Arial" font-weight="800" font-size="14" fill="#10B981">₹520</text>
    <text x="880" y="170" font-family="Arial" font-weight="800" font-size="14" fill="#38BDF8">74.2%</text>

    <path d="M50,195 L1070,195" stroke="#334155" />
    <text x="60" y="225" font-family="Arial" font-weight="700" font-size="14" fill="#FFF">Gurgaon</text>
    <text x="250" y="225" font-family="Arial" font-weight="800" font-size="14" fill="#E23744">1,118</text>
    <text x="450" y="225" font-family="Arial" font-weight="800" font-size="14" fill="#F59E0B">4.32 ★</text>
    <text x="650" y="225" font-family="Arial" font-weight="800" font-size="14" fill="#10B981">₹710</text>
    <text x="880" y="225" font-family="Arial" font-weight="800" font-size="14" fill="#38BDF8">81.5%</text>

    <path d="M50,250 L1070,250" stroke="#334155" />
    <text x="60" y="280" font-family="Arial" font-weight="700" font-size="14" fill="#FFF">Noida</text>
    <text x="250" y="280" font-family="Arial" font-weight="800" font-size="14" fill="#E23744">780</text>
    <text x="450" y="280" font-family="Arial" font-weight="800" font-size="14" fill="#F59E0B">4.08 ★</text>
    <text x="650" y="280" font-family="Arial" font-weight="800" font-size="14" fill="#10B981">₹480</text>
    <text x="880" y="280" font-family="Arial" font-weight="800" font-size="14" fill="#38BDF8">72.0%</text>

    <path d="M50,305 L1070,305" stroke="#334155" />
    <text x="60" y="335" font-family="Arial" font-weight="700" font-size="14" fill="#FFF">Bengaluru</text>
    <text x="250" y="335" font-family="Arial" font-weight="800" font-size="14" fill="#E23744">591</text>
    <text x="450" y="335" font-family="Arial" font-weight="800" font-size="14" fill="#F59E0B">4.41 ★</text>
    <text x="650" y="335" font-family="Arial" font-weight="800" font-size="14" fill="#10B981">₹650</text>
    <text x="880" y="335" font-family="Arial" font-weight="800" font-size="14" fill="#38BDF8">88.4%</text>
  </g>
</svg>
