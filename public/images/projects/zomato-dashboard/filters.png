<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#0F172A" /><stop offset="100%" stop-color="#1E293B" /></linearGradient>
    <linearGradient id="cardBg" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#1E293B" /><stop offset="100%" stop-color="#0F172A" /></linearGradient>
  </defs>
  <rect width="1200" height="675" fill="url(#bg)" />
  <rect x="40" y="30" width="1120" height="70" rx="16" fill="url(#cardBg)" stroke="#334155" />
  <text x="70" y="72" font-family="Arial" font-weight="900" font-size="22" fill="#E23744">DYNAMIC SLICERS &amp; INTERACTIVE DRILL-THROUGH FILTERS</text>

  <g transform="translate(40, 130)">
    <rect width="1120" height="500" rx="16" fill="url(#cardBg)" stroke="#334155" />
    <text x="40" y="50" font-family="Arial" font-weight="800" font-size="16" fill="#FFF">POWER BI DYNAMIC SLICERS PANE</text>

    <rect x="60" y="90" width="480" height="170" rx="12" fill="#1E293B" stroke="#475569" />
    <text x="80" y="125" font-family="Arial" font-weight="800" font-size="15" fill="#38BDF8">GEOGRAPHIC CITY FILTER SLICER</text>
    <rect x="80" y="145" width="440" height="40" rx="8" fill="#334155" />
    <text x="100" y="170" font-family="Arial" font-weight="700" font-size="14" fill="#FFF">✔ All Cities Selected (New Delhi, Gurgaon, Noida, Bengaluru...)</text>

    <rect x="580" y="90" width="480" height="170" rx="12" fill="#1E293B" stroke="#475569" />
    <text x="600" y="125" font-family="Arial" font-weight="800" font-size="15" fill="#F59E0B">CUISINE TYPE CATEGORY SLICER</text>
    <rect x="600" y="145" width="440" height="40" rx="8" fill="#334155" />
    <text x="620" y="170" font-family="Arial" font-weight="700" font-size="14" fill="#FFF">✔ Filter by North Indian, Chinese, Continental, Desserts</text>

    <rect x="60" y="290" width="480" height="170" rx="12" fill="#1E293B" stroke="#475569" />
    <text x="80" y="325" font-family="Arial" font-weight="800" font-size="15" fill="#10B981">ONLINE DELIVERY TOGGLE SLICER</text>
    <rect x="80" y="345" width="440" height="40" rx="8" fill="#334155" />
    <text x="100" y="370" font-family="Arial" font-weight="700" font-size="14" fill="#FFF">✔ Yes (Only Restaurants Delivering Online)</text>

    <rect x="580" y="290" width="480" height="170" rx="12" fill="#1E293B" stroke="#475569" />
    <text x="600" y="325" font-family="Arial" font-weight="800" font-size="15" fill="#8B5CF6">RATING RANGE SLIDER (2.0 TO 5.0)</text>
    <rect x="600" y="345" width="440" height="40" rx="8" fill="#334155" />
    <text x="620" y="370" font-family="Arial" font-weight="700" font-size="14" fill="#FFF">✔ Active Range: 3.5★ - 5.0★</text>
  </g>
</svg>
