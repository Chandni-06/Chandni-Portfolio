# Serverless contact form endpoint used by the frontend.
# Set this to your platform's function URL.
VITE_CONTACT_ENDPOINT="YOUR_FUNCTION_ENDPOINT"

# SMTP configuration used inside the Netlify Function.
SMTP_HOST="YOUR_SMTP_HOST"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="YOUR_SMTP_USER"
SMTP_PASS="YOUR_SMTP_PASS"
SMTP_FROM="YOUR_SMTP_FROM"
CONTACT_RECIPIENT_EMAIL="YOUR_RECIPIENT_EMAIL"
