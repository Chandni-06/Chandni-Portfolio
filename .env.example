# Serverless contact form endpoint used by the frontend.
# For Netlify, the default is /.netlify/functions/contact.
VITE_CONTACT_ENDPOINT="/.netlify/functions/contact"

# SMTP configuration used inside the Netlify Function.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="your-email@gmail.com"
CONTACT_RECIPIENT_EMAIL="your-recipient@gmail.com"
